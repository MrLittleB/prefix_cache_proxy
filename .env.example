# ==================== prefix-hash-router 配置示例 ====================
# 用法: 复制本文件为 .env（cp .env.example .env），按需修改。
# 优先级: 命令行参数 > .env > 代码内置默认值。
# 即: 启动时显式传的参数会覆盖 .env; .env 里的值会覆盖代码内置默认值。
#
# 注意: .env 已被 .gitignore 忽略, 不会提交到仓库; 请勿把真实密钥写进代码。

# vLLM 上游 base（到 /v1 为止）
# 示例: UPSTREAM=https://your-vllm-host:30079/v1
UPSTREAM=http://localhost:9100/v1

# vLLM /metrics 地址（默认由 UPSTREAM 推导为同 host 的 /metrics, 一般无需设置）
# METRICS_URL=

# 拉取 /metrics 时的 Bearer token（若 /metrics 需要鉴权。敏感，务必只在 .env 里配）
# METRICS_TOKEN=

# 监听地址 / 端口
HOST=0.0.0.0
PORT=38294

# DP 数量（须与实际 engine 数一致）
DP_SIZE=8

# 路由模式: prefix_hash / consistent_hash / radix / first_rank / round_robin
MODE=prefix_hash

# wait 的渐进权重上限（默认4）：第1个waiting权重2、第2个3、第3个起4。
# 这样前 1~2 个 waiting 不被夸大，排队深才体现压力；避免瞬时小 waiting 误判过载。
WAITING_WEIGHT=4.0

# 过载判定: 相对失衡系数（配合下面的 MIN_LOAD_FOR_OVERLOAD 使用）
LOAD_SKEW=1.5

# 过载绝对门槛(running+waiting): 只有首选 rank 负载 >= 该值 才可能 spill；
# 低于该值不干预，保持 radix 前缀一致。设极大值 = 相当于关闭过载保护。
MIN_LOAD_FOR_OVERLOAD=5.0

# 请求体上限(字节, 0=不限制) / 并发线程上限 / radix 树节点上限
MAX_BODY_SIZE=0
MAX_WORKERS=256
RADIX_MAX_NODES=100000

# 精简路由诊断 [route] 行 (rank/radix命中/会话键). true=打印
DEBUG_RANK=false
# 深度调试 [radix-debug]/[forward-debug]/[overload SPILL], 与 DEBUG_RANK 独立; 默认关
# DEEP_DEBUG=false
